{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "./",
  "name": "พจนานุกรมฉบับซาราซาคสกุล · Zaan Translate",
  "short_name": "พจนานุกรมซาราซาค",
  "description": "พจนานุกรมภาษาซาน — ค้นหาคำศัพท์และแปลภาษาด้วย Zaan Translate",
  "lang": "th",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "prefer_related_applications": false,
  "categories": [
    "education",
    "reference",
    "books"
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "ค้นหาคำศัพท์",
      "short_name": "ค้นหา",
      "description": "เปิดพจนานุกรมพร้อมช่องค้นหา",
      "url": "./?shortcut=search",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Zaan Translate",
      "short_name": "แปลภาษา",
      "description": "เปิดหน้าแปลภาษาไทย ⇆ ซาน",
      "url": "./?shortcut=translate",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "ระบบควบคุม",
      "short_name": "ระบบควบคุม",
      "description": "เปิดหน้าล็อกอินระบบควบคุม",
      "url": "./?shortcut=admin",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ]
}